# Production: PostgreSQL only. Use a managed database and TLS where available.
NODE_ENV=production
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/SMART_TAXI?sslmode=require
APP_ORIGIN=https://crm.example.co.uk
PORT=3001
SESSION_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_COOKIE_NAME=sts_session

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# AI defaults to local Ollama. External providers are disabled until an Admin enables them.
AI_ENABLED=true
AI_PROVIDER=ollama
AI_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_API_KEY=
AI_BASE_URL=
